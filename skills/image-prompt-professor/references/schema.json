{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Prompt Professor Output",
  "description": "English keyword package or an ordered nonempty array of packages; Chinese explanation tables are outside JSON",
  "oneOf": [
    {
      "$ref": "#/$defs/prompt_package"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prompt_package"
      }
    }
  ],
  "$defs": {
    "clean_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[.:;])[\\x20-\\x7E]*[\\x21-\\x7E][\\x20-\\x7E]*$"
    },
    "style_theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_style",
        "mood",
        "theme",
        "visual_vibe"
      ],
      "properties": {
        "primary_style": {
          "$ref": "#/$defs/clean_string"
        },
        "mood": {
          "$ref": "#/$defs/clean_string"
        },
        "theme": {
          "$ref": "#/$defs/clean_string"
        },
        "visual_vibe": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "character_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "proportions",
        "pose",
        "facial_features",
        "clothing"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/clean_string"
        },
        "proportions": {
          "$ref": "#/$defs/clean_string"
        },
        "pose": {
          "$ref": "#/$defs/clean_string"
        },
        "facial_features": {
          "$ref": "#/$defs/clean_string"
        },
        "clothing": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "scene_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "environment",
        "additional_details"
      ],
      "properties": {
        "setting": {
          "$ref": "#/$defs/clean_string"
        },
        "environment": {
          "$ref": "#/$defs/clean_string"
        },
        "additional_details": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "color_palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_colors",
        "saturation",
        "contrast"
      ],
      "properties": {
        "dominant_colors": {
          "$ref": "#/$defs/clean_string"
        },
        "saturation": {
          "$ref": "#/$defs/clean_string"
        },
        "contrast": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "composition_and_perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "arrangement",
        "perspective",
        "depth_of_field",
        "framing"
      ],
      "properties": {
        "composition": {
          "$ref": "#/$defs/clean_string"
        },
        "arrangement": {
          "$ref": "#/$defs/clean_string"
        },
        "perspective": {
          "$ref": "#/$defs/clean_string"
        },
        "depth_of_field": {
          "$ref": "#/$defs/clean_string"
        },
        "framing": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "lighting_and_atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lighting",
        "shadows",
        "atmosphere"
      ],
      "properties": {
        "lighting": {
          "$ref": "#/$defs/clean_string"
        },
        "shadows": {
          "$ref": "#/$defs/clean_string"
        },
        "atmosphere": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "image_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "focus",
        "rendering_quality"
      ],
      "properties": {
        "resolution": {
          "$ref": "#/$defs/clean_string"
        },
        "focus": {
          "$ref": "#/$defs/clean_string"
        },
        "rendering_quality": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "typography_and_layout_potential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aesthetic_category",
        "text_space"
      ],
      "properties": {
        "aesthetic_category": {
          "$ref": "#/$defs/clean_string"
        },
        "text_space": {
          "$ref": "#/$defs/clean_string"
        }
      }
    },
    "prompt_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_features",
        "scene_features",
        "color_palette",
        "lighting_and_atmosphere",
        "composition_and_perspective",
        "image_quality",
        "style_theme",
        "typography_and_layout_potential",
        "prompt"
      ],
      "properties": {
        "character_features": {
          "$ref": "#/$defs/character_features"
        },
        "scene_features": {
          "$ref": "#/$defs/scene_features"
        },
        "color_palette": {
          "$ref": "#/$defs/color_palette"
        },
        "lighting_and_atmosphere": {
          "$ref": "#/$defs/lighting_and_atmosphere"
        },
        "composition_and_perspective": {
          "$ref": "#/$defs/composition_and_perspective"
        },
        "image_quality": {
          "$ref": "#/$defs/image_quality"
        },
        "style_theme": {
          "$ref": "#/$defs/style_theme"
        },
        "typography_and_layout_potential": {
          "$ref": "#/$defs/typography_and_layout_potential"
        },
        "prompt": {
          "type": "string",
          "minLength": 2,
          "pattern": "^(?!.*[.:;])(?:[\\x20-\\x2B\\x2D-\\x7E]*[\\x21-\\x2B\\x2D-\\x7E],)+$"
        }
      }
    }
  }
}
